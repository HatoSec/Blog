---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUDIENCES, tagSlug } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, audience, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 1.6em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.audience-tags {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 1em;
			}
			.audience-badge {
				display: inline-block;
				font-size: 0.8em;
				padding: 0.2em 0.7em;
				border-radius: 4px;
				background: rgb(50, 56, 74);
				color: rgb(var(--gray-dark));
			}
			.tag-list {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 1em;
			}
			.tag-badge {
				display: inline-block;
				font-size: 0.75em;
				padding: 0.2em 0.7em;
				border-radius: 4px;
				background: #dc2626;
				color: #fff;
				text-decoration: none;
			}
			.tag-badge:hover {
				opacity: 0.8;
			}
		</style>
	</head>

	<body>
		<Header activeAudience="all" />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					{title && (
					<div class="title">
						{pubDate && (
							<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						)}
						<h1>{title}</h1>
						<div class="audience-tags">
							{audience?.map((a) => <span class="audience-badge">{AUDIENCES.find((au) => au.id === a)?.range ?? a}</span>)}
						</div>
						{tags && tags.length > 0 && (
							<div class="tag-list">
								{tags.map((tag) => (
									<a href={`/blog/tags/${tagSlug(tag)}/`} class="tag-badge">{tag}</a>
								))}
							</div>
						)}
						<hr />
					</div>
					)}
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
