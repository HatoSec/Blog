---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, audienceBadge, tagSlug } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
			}
			h1 {
				margin-bottom: 0.3em;
				font-family: 'Jersey 10', sans-serif;
				font-weight: 400;
			}
			.posts-grid {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.posts-grid li {
				width: 100%;
				text-align: center;
				margin-bottom: 1rem;
			}
			.posts-grid li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.posts-grid li img {
				width: 100%;
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.posts-grid li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
				font-size: 2.369rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.description {
				margin: 0.4em 0;
				color: rgb(var(--gray-dark));
				font-size: 0.9em;
				line-height: 1.5;
			}
			.posts-grid li a:hover h4,
			.posts-grid li a:hover .date {
				color: rgb(var(--accent));
			}
			.posts-grid a:hover img {
				box-shadow: var(--box-shadow);
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-top: 0.4em;
				justify-content: center;
			}
			.audience-badge {
				display: inline-block;
				font-size: 0.75em;
				padding: 0.15em 0.6em;
				border-radius: 4px;
				background: rgb(50, 56, 74);
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.tag-badge {
				display: inline-block;
				font-size: 0.75em;
				padding: 0.15em 0.6em;
				border-radius: 4px;
		background: #dc2626;
			color: #fff;
				text-decoration: none;
			}
			.tag-badge:hover {
				opacity: 0.8;
			}
			.empty-state {
				color: rgb(var(--gray));
				text-align: center;
				padding: 3em;
				width: 100%;
			}
			@media (max-width: 720px) {
				.posts-grid {
					gap: 1em;
				}
				.title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header activeAudience="all" />
		<main>
			<h1>All Posts</h1>

			{posts.length > 0 ? (
				<ul class="posts-grid">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="description">{post.data.description}</p>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="post-meta">
									{(post.data.audience ?? []).map((a) => (
										<span class="audience-badge">{audienceBadge(a)}</span>
									))}
									{(post.data.tags ?? []).map((tag) => (
										<a href={`/blog/tags/${tagSlug(tag)}/`} class="tag-badge">{tag}</a>
									))}
								</p>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">No posts yet — check back soon for new guides!</p>
			)}
		</main>
		<Footer />
	</body>
</html>
