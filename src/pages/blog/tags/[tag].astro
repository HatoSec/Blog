---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, audienceBadge, tagSlug } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tagSet = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			tagSet.add(tag);
		}
	}
	return Array.from(tagSet).map((tag) => ({
		params: { tag: tagSlug(tag) },
		props: { tag },
	}));
}

const { tag } = Astro.props;

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => (post.data.tags ?? []).includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${tag} — Blog — ${SITE_TITLE}`} description={`Posts tagged with "${tag}" — ${SITE_DESCRIPTION}`} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
			}
			h1 {
				margin-bottom: 0.3em;
				font-family: 'Jersey 10', sans-serif;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1em;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.posts-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.posts-list li {
				padding: 1em 0;
				border-bottom: 1px solid rgb(50, 56, 74);
			}
			.posts-list li:last-child {
				border-bottom: none;
			}
			.posts-list a {
				text-decoration: none;
				display: block;
			}
			.posts-list a:hover h3 {
				color: var(--accent);
			}
			.posts-list h3 {
				margin: 0 0 0.3em;
				color: rgb(var(--black));
				transition: 0.2s ease;
			}
			.description {
				margin: 0.3em 0;
				color: rgb(var(--gray-dark));
				font-size: 0.9em;
				line-height: 1.5;
			}
			.post-meta {
				font-size: 0.85em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.audience-badge {
				display: inline-block;
				font-size: 0.75em;
				padding: 0.15em 0.6em;
				border-radius: 4px;
				background: rgb(50, 56, 74);
				color: rgb(var(--gray-dark));
				text-decoration: none;
				margin-right: 0.4em;
			}
			.tag-badge {
				display: inline-block;
				font-size: 0.75em;
				padding: 0.15em 0.6em;
				border-radius: 4px;
				background: #dc2626;
				color: #fff;
				text-decoration: none;
				margin-right: 0.4em;
			}
			.tag-hero {
				background: rgb(38, 42, 58);
				padding: 2em;
				margin-bottom: 1em;
				text-align: center;
				border-radius: 8px;
			}
			.tag-hero h1 {
				margin: 0 0 0.3em;
			}
			.tag-hero p {
				margin: 0.3em 0 0;
				color: rgb(var(--gray));
			}
			.tag-description {
				font-size: 0.85em;
				margin-top: 0.5em !important;
			}
			.empty-state {
				color: rgb(var(--gray));
				text-align: center;
				padding: 3em;
			}
		</style>
	</head>
	<body>
		<Header activeAudience="all" />
		<main>
			<a class="back-link" href="/blog/">← Back to all posts</a>
			<div class="tag-hero">
				<h1>#{tag}</h1>
				<p>{posts.length} {posts.length === 1 ? "post" : "posts"} tagged with "{tag}"</p>
				<p class="tag-description">{SITE_DESCRIPTION}</p>
			</div>

			{posts.length > 0 ? (
				<ul class="posts-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								{post.data.description && <p class="description">{post.data.description}</p>}
								<p class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.audience?.map((a) => (
										<span class="audience-badge">{audienceBadge(a)}</span>
									))}
								</p>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">No posts found with this tag.</p>
			)}
		</main>
		<Footer />
	</body>
</html>
